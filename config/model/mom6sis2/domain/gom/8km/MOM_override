! What makes this gom_8km and not another Gulf resolution, plus what
! ACKBAR changes about the shared configuration. Read
! config/model/mom6sis2/domain/gom/common/MOM_input for the rest.
!
! No `#override` on the first two sections: the shared base does not
! set these at all, precisely so that each domain must state them.

! --- the resolution ---------------------------------------------

NIGLOBAL = 271
NJGLOBAL = 173
DT = 900.0
DT_THERM = 1800.0
TEMP_SALT_Z_INIT_FILE = "ic.nc"

! NK, COORD_CONFIG and ALE_COORDINATE_CONFIG are deliberately absent. The
! vertical grid is shared by every Gulf resolution and is stated once in
! gom/common/MOM_input, because two resolutions that differ vertically are
! not comparable. Restating one here without `#override` is a fatal.
!
! This domain is where that mattered most. It was the only Gulf resolution
! at 25 layers instead of 36, the only one with COORD_CONFIG = "file", and
! the only one whose ALE target came from an analytic FNC1 rather than the
! shared hycom1 file. Nothing about 8 km asked for any of that.

! --- inherited drift --------------------------------------------
!
! Differences between the four Gulf resolutions with no resolution
! reason: hand edits from 2021 that were never reconciled. They are here
! rather than collapsed into the shared base so that this split
! changes no answers. Each one is a decision waiting to be made,
! and making it means deleting the line here and setting the value
! once in gom/common/MOM_input.

BUOY_CONFIG = 'zero'
DAYMAX = 10000
! DIABATIC_FIRST is unset here and set in another Gulf domain
ENERGYSAVEDAYS = 0.0416666666666667
FRAZIL = True
MAXTRUNC = 100000
OBC_SEGMENT_001_VELOCITY_NUDGING_TIMESCALES = 0.3, 360.0
OBC_SEGMENT_002_VELOCITY_NUDGING_TIMESCALES = 0.3, 360.0
OBC_SEGMENT_003_VELOCITY_NUDGING_TIMESCALES = 0.3, 360.0
OBC_TRACER_RESERVOIR_LENGTH_SCALE_IN = 3e3
OBC_TRACER_RESERVOIR_LENGTH_SCALE_OUT = 3e3
! SAVE_INITIAL_CONDS is unset here and set in another Gulf domain
THERMO_SPANS_COUPLING = True
WIND_CONFIG = 'zero'

! --- ackbar ------------------------------------------------------

ENABLE_BUGS_BY_DEFAULT = False

! An intermediate restart is time-stamped instead of overwriting MOM.res.nc.
! `ocean_model_restart` writes nothing at all unless RESTART_CONTROL has a bit
! set, and it is the default bit 0 that overwrites: a forecast given a
! `restart_interval` would rewrite one file once per interval and end with the
! same single state it started with. Bit 1 is the time-stamped write, which is
! what a sub-window state is. Inert for a forecast that was given no interval,
! which is every 3D experiment. See `forecast.slots` in config/schema and
! MOM_STAMP in ackbar/mom6sis2.py for the name it produces.
RESTART_CONTROL = 2

! Deliberately not overridden, and here so nobody "fixes" it:
!
! MOM_input states OBC_COMPUTED_VORTICITY and OBC_FREESLIP_VORTICITY, both
! obsolete in favour of OBC_VORTICITY_CONFIG. MOM6 still translates them and
! warns, and the translation is correct: the run reports
! OBC_VORTICITY_CONFIG = "computed", not the "freeslip" default, so this
! intent survives. Overriding the modern name while the obsolete pair is still
! stated risks the same fatal that USTAR_GUSTLESS_BUG produces on OM_1deg,
! where MOM6 refuses to start on two spellings of one flag. Rewrite MOM_input
! when the translation is dropped, not before.
