"ATM" , "p_surf"        , ""            , ""                             , "bilinear" ,  1.e5
"ATM" , "p_bot"         , ""            , ""                             , "bilinear" ,  1.e5
"ATM" , "t_bot"         , "T2"          , "INPUT/atm.nc"                 , "bilinear" ,  1.0
"ATM" , "sphum_bot"     , "Q2"          , "INPUT/atm.nc"                 , "bilinear" ,  1.0
"ATM" , "u_bot"         , "U10"         , "INPUT/atm.nc"                 , "bicubic",    1.0
"ATM" , "v_bot"         , "V10"         , "INPUT/atm.nc"                 , "bicubic",    1.0
# z_bot is the one height the coupler believes the whole state above sits at,
# and it is the reference level for the bulk fluxes. It is true of all four
# fields: the winds are published at 10 m, and T2 and Q2 are published at 2 m
# and shifted to 10 m when the forcing archive is built, so that this number is
# a fact about the file rather than a claim about it. Each atm.nc records the
# height it holds and the model refuses one that will not say.
#
# Do not "fix" this by writing 2.0 here. It was true once and is not now, and
# it would mislabel the winds and cost 28 to 56 per cent on the stress to save
# about 10 per cent on the turbulent fluxes.
# See docs/forcing-reference-height.md.
"ATM" , "z_bot"         , ""            , ""                             , "bilinear" , 10.0
"ATM" , "gust"          , ""            , ""                             , "bilinear" ,  1.0e-4
